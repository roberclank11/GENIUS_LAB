          <mapperTableEntries name="r04_fecha_compra_valida" expression="row1.order_purchase_timestamp != null&#xD;&#xA;&#x9;&#x9;&#x9;&amp;&amp; !row1.order_purchase_timestamp.trim().isEmpty()&#xD;&#xA;&#x9;&#x9;&#x9;&amp;&amp; TalendDate.isDateStrict(&#xD;&#xA;&#x9;&#x9;&#x9;    row1.order_purchase_timestamp.trim(),&#xD;&#xA;&#x9;&#x9;&#x9;    &quot;yyyy-MM-dd HH:mm:ss&quot;&#xD;&#xA;&#x9;&#x9;&#x9;) " type="id_Boolean"/>
          <mapperTableEntries name="r05_aprobacion_consistente" expression="row1.order_approved_at == null&#xD;&#xA;&#x9;&#x9;&#x9;|| row1.order_approved_at.trim().isEmpty()&#xD;&#xA;&#x9;&#x9;&#x9;|| (&#xD;&#xA;&#x9;&#x9;&#x9;    Var.r04_fecha_compra_valida&#xD;&#xA;&#x9;&#x9;&#x9;    &amp;&amp; TalendDate.isDateStrict(&#xD;&#xA;&#x9;&#x9;&#x9;        row1.order_approved_at.trim(),&#xD;&#xA;&#x9;&#x9;&#x9;        &quot;yyyy-MM-dd HH:mm:ss&quot;&#xD;&#xA;&#x9;&#x9;&#x9;    )&#xD;&#xA;&#x9;&#x9;&#x9;    &amp;&amp; !TalendDate.parseDate(&#xD;&#xA;&#x9;&#x9;&#x9;        &quot;yyyy-MM-dd HH:mm:ss&quot;,&#xD;&#xA;&#x9;&#x9;&#x9;        row1.order_approved_at.trim()&#xD;&#xA;&#x9;&#x9;&#x9;    ).before(&#xD;&#xA;&#x9;&#x9;&#x9;        TalendDate.parseDate(&#xD;&#xA;&#x9;&#x9;&#x9;            &quot;yyyy-MM-dd HH:mm:ss&quot;,&#xD;&#xA;&#x9;&#x9;&#x9;            row1.order_purchase_timestamp.trim()&#xD;&#xA;&#x9;&#x9;&#x9;        )&#xD;&#xA;&#x9;&#x9;&#x9;    )&#xD;&#xA;&#x9;&#x9;&#x9;) " type="id_Boolean"/>
          <mapperTableEntries name="r06_entrega_informada" expression="!&quot;delivered&quot;.equals(row1.order_status)&#xD;&#xA;&#x9;|| (&#xD;&#xA;&#x9;    row1.order_delivered_customer_date != null&#xD;&#xA;&#x9;    &amp;&amp; !row1.order_delivered_customer_date.trim().isEmpty()&#xD;&#xA;&#x9;    &amp;&amp; TalendDate.isDateStrict(&#xD;&#xA;&#x9;        row1.order_delivered_customer_date.trim(),&#xD;&#xA;&#x9;        &quot;yyyy-MM-dd HH:mm:ss&quot;&#xD;&#xA;&#x9;    )&#xD;&#xA;&#x9;) " type="id_Boolean"/>
          <mapperTableEntries name="r07_entrega_consistente" expression="!&quot;delivered&quot;.equals(row1.order_status)&#xD;&#xA;&#x9;|| (&#xD;&#xA;&#x9;    Var.r04_fecha_compra_valida&#xD;&#xA;&#x9;    &amp;&amp; Var.r06_entrega_informada&#xD;&#xA;&#x9;    &amp;&amp; !TalendDate.parseDate(&#xD;&#xA;&#x9;        &quot;yyyy-MM-dd HH:mm:ss&quot;,&#xD;&#xA;&#x9;        row1.order_delivered_customer_date.trim()&#xD;&#xA;&#x9;    ).before(&#xD;&#xA;&#x9;        TalendDate.parseDate(&#xD;&#xA;&#x9;            &quot;yyyy-MM-dd HH:mm:ss&quot;,&#xD;&#xA;&#x9;            row1.order_purchase_timestamp.trim()&#xD;&#xA;&#x9;        )&#xD;&#xA;&#x9;    )&#xD;&#xA;&#x9;) " type="id_Boolean"/>
          <mapperTableEntries name="registro_valido" expression="Var.r01_id_valido&#xD;&#xA;&#x9;&amp;&amp; Var.r02_cliente_valido&#xD;&#xA;&#x9;&amp;&amp; Var.r03_estado_valido&#xD;&#xA;&#x9;&amp;&amp; Var.r04_fecha_compra_valida&#xD;&#xA;&#x9;&amp;&amp; Var.r05_aprobacion_consistente&#xD;&#xA;&#x9;&amp;&amp; Var.r06_entrega_informada&#xD;&#xA;&#x9;&amp;&amp; Var.r07_entrega_consistente " type="id_Boolean"/>
