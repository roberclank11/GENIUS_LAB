    <elementParameter field="TEXT" name="HELP" value="org.talend.help.tJava" show="false"/>
    <elementParameter field="DIRECTORY" name="IREPORT_PATH" value="" show="false"/>
    <elementParameter field="DIRECTORY" name="JAVA_LIBRARY_PATH" value="C:\Talend\8.0.1\studio\configuration\lib\java" show="false"/>
    <elementParameter field="MEMO_EDITOR_JAVA" name="CODE" value="&#xD;&#xA;String[] archivos = {&#xD;&#xA;    &quot;olist_customers_dataset.csv&quot;,&#xD;&#xA;    &quot;olist_order_items_dataset.csv&quot;,&#xD;&#xA;    &quot;olist_order_payments_dataset.csv&quot;,&#xD;&#xA;    &quot;olist_orders_dataset.csv&quot;,&#xD;&#xA;    &quot;olist_products_dataset.csv&quot;&#xD;&#xA;};&#xD;&#xA;&#xD;&#xA;long totalFilas = 0;&#xD;&#xA;&#xD;&#xA;try {&#xD;&#xA;    for (String archivo : archivos) {&#xD;&#xA;&#xD;&#xA;        java.nio.file.Path ruta = java.nio.file.Paths.get(&#xD;&#xA;            context.FILE_OLIST, archivo&#xD;&#xA;        );&#xD;&#xA;&#xD;&#xA;        long filas = 0;&#xD;&#xA;&#xD;&#xA;        try (java.io.BufferedReader br =&#xD;&#xA;            java.nio.file.Files.newBufferedReader(&#xD;&#xA;                ruta, java.nio.charset.StandardCharsets.UTF_8)) {&#xD;&#xA;&#xD;&#xA;            br.readLine(); // Saltar cabecera&#xD;&#xA;&#xD;&#xA;            while (br.readLine() != null) {&#xD;&#xA;                filas++;&#xD;&#xA;            }&#xD;&#xA;        }&#xD;&#xA;&#xD;&#xA;        totalFilas += filas;&#xD;&#xA;&#xD;&#xA;        System.out.println(archivo + &quot;: &quot; + filas + &quot; filas&quot;);&#xD;&#xA;    }&#xD;&#xA;&#xD;&#xA;    globalMap.put(&quot;ROWS_IN&quot;, totalFilas);&#xD;&#xA;&#xD;&#xA;    System.out.println(&quot;----------------------------&quot;);&#xD;&#xA;    System.out.println(&quot;TOTAL ROWS_IN: &quot; + totalFilas);&#xD;&#xA;&#xD;&#xA;} catch (Exception e) {&#xD;&#xA;    throw new RuntimeException(&#xD;&#xA;        &quot;Error al contabilizar los CSV: &quot; + e.getMessage(), e&#xD;&#xA;    );&#xD;&#xA;}&#xD;&#xA;"/>
    <elementParameter field="MEMO_EDITOR_IMPORT" name="IMPORT" value="//import java.util.List;"/>
    <elementParameter field="TEXT" name="LABEL" value="tJava_count_rows"/>
    <elementParameter field="TEXT" name="CONNECTION_FORMAT" value="row"/>
    <metadata connector="FLOW" name="tJava_1"/>
  </node>
