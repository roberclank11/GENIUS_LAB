    <elementParameter field="TECHNICAL" name="QUERYSTORE:QUERYSTORE_TYPE" value="BUILT_IN"/>
    <elementParameter field="MEMO_SQL" name="QUERY" value="&#xD;&#xA;&quot;UPDATE DWHDEV.audit_pipeline_runs_eq4 SET &quot; +&#xD;&#xA;&quot;status='OK', &quot; +&#xD;&#xA;&quot;ended_at='&quot; + TalendDate.formatDate(&quot;yyyy-MM-dd HH:mm:ss&quot;, TalendDate.getCurrentDate()) + &quot;', &quot; +&#xD;&#xA;&quot;notes='Pipeline completado correctamente', &quot; +&#xD;&#xA;&#xD;&#xA;&quot;rows_in=&quot; + globalMap.get(&quot;ROWS_IN&quot;) + &quot;, &quot; +&#xD;&#xA;&#xD;&#xA;&quot;rows_out=(&quot; +&#xD;&#xA;&quot;  SELECT &quot; +&#xD;&#xA;&quot;  (SELECT COUNT(*) FROM DWHDEV.dim_customer_eq4) + &quot; +&#xD;&#xA;&quot;  (SELECT COUNT(*) FROM DWHDEV.dim_product_eq4) + &quot; +&#xD;&#xA;&quot;  (SELECT COUNT(*) FROM DWHDEV.fact_orders_eq4) + &quot; +&#xD;&#xA;&quot;  (SELECT COUNT(*) FROM DWHDEV.fact_order_items_eq4) + &quot; +&#xD;&#xA;&quot;  (SELECT COUNT(*) FROM DWHDEV.fact_order_payments_eq4)&quot; +&#xD;&#xA;&quot;), &quot; +&#xD;&#xA;&#xD;&#xA;&quot;rows_rejected=(&quot; +&#xD;&#xA;&quot;  SELECT COUNT(*) FROM DWHDEV.audit_rejects_eq4&quot; +&#xD;&#xA;&quot;) &quot; +&#xD;&#xA;&#xD;&#xA;&quot;WHERE run_id=(&quot; +&#xD;&#xA;&quot;  SELECT MAX(x.run_id) FROM (&quot; +&#xD;&#xA;&quot;    SELECT run_id FROM DWHDEV.audit_pipeline_runs_eq4 &quot; +&#xD;&#xA;&quot;    WHERE pipeline_name='&quot; + context.PIPELINE_NAME + &quot;' &quot; +&#xD;&#xA;&quot;    AND status='RUNNING'&quot; +&#xD;&#xA;&quot;  ) x&quot; +&#xD;&#xA;&quot;)&quot;&#xD;&#xA;"/>
    <elementParameter field="LABEL" name="NOTE" value="This option only applies when deploying and running in the Talend Runtime" show="false"/>
