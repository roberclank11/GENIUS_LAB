    <elementParameter field="MEMO_EDITOR_JAVA" name="CODE_START" value="Map&lt;String,Integer> minLen_5 = new HashMap&lt;String,Integer>();&#xA;Map&lt;String,Integer> maxLen_5 = new HashMap&lt;String,Integer>();&#xA;String[] cols_5 = {&quot;CEDULA&quot;,&quot;NOMBRES&quot;,&quot;APELLIDOS&quot;,&quot;DIRECCION_CASA&quot;,&quot;DIRECCION_OFICINA&quot;,&quot;TELEFONO_CASA&quot;,&quot;TELEFONO_OFICINA&quot;};"/>
    <elementParameter field="MEMO_EDITOR_JAVA" name="CODE_MAIN" value="String[] vals_5 = {&#xA;    row_rep_lengths.CEDULA,&#xA;    row_rep_lengths.NOMBRES,&#xA;    row_rep_lengths.APELLIDOS,&#xA;    row_rep_lengths.DIRECCION_CASA,&#xA;    row_rep_lengths.DIRECCION_OFICINA,&#xA;    row_rep_lengths.TELEFONO_CASA,&#xA;    row_rep_lengths.TELEFONO_OFICINA&#xA;};&#xA;for (int i_5 = 0; i_5 &lt; cols_5.length; i_5++) {&#xA;    String v_5 = vals_5[i_5];&#xA;    if (v_5 == null) continue;&#xA;    int len_5 = v_5.length();&#xA;    String col_5 = cols_5[i_5];&#xA;    if (!minLen_5.containsKey(col_5) || len_5 &lt; minLen_5.get(col_5)) minLen_5.put(col_5, len_5);&#xA;    if (!maxLen_5.containsKey(col_5) || len_5 > maxLen_5.get(col_5)) maxLen_5.put(col_5, len_5);&#xA;}&#xA;output_row.resultado = null;"/>
    <elementParameter field="MEMO_EDITOR_JAVA" name="CODE_END" value="System.out.println(&quot;============================================================&quot;);&#xA;System.out.println(&quot;[5] LONGITUDES MIN/MAX DE CAMPOS DE TEXTO&quot;);&#xA;System.out.println(&quot;    (los valores null se ignoran; las cadenas vacias tienen longitud 0 y se incluyen)&quot;);&#xA;System.out.println(&quot;------------------------------------------------------------&quot;);&#xA;System.out.printf(&quot;  %-22s %6s %6s%n&quot;, &quot;COLUMNA&quot;, &quot;MIN&quot;, &quot;MAX&quot;);&#xA;System.out.println(&quot;  ---------------------- ------ ------&quot;);&#xA;for (String c_5 : cols_5) {&#xA;    String minV_5 = minLen_5.containsKey(c_5) ? String.valueOf(minLen_5.get(c_5)) : &quot;N/A&quot;;&#xA;    String maxV_5 = maxLen_5.containsKey(c_5) ? String.valueOf(maxLen_5.get(c_5)) : &quot;N/A&quot;;&#xA;    System.out.printf(&quot;  %-22s %6s %6s%n&quot;, c_5, minV_5, maxV_5);&#xA;}&#xA;System.out.println(&quot;============================================================&quot;);"/>
    <elementParameter field="CHECK" name="Version_V2_0" value="false" show="false"/>
    <elementParameter field="CHECK" name="Version_V3_2" value="false" show="false"/>
