      <indicators xsi:type="dataquality.indicators:NullCountIndicator" xmi:id="_hrJZEtF1EfGlKpMundrNlA" count="32951" computed="true">
        <parameters xmi:id="_hrJZE9F1EfGlKpMundrNlA"/>
        <analyzedElement xsi:type="TalendMetadata:MetadataColumn" href="../../../metadata/fileDelimited/OLIST/Products_0.1.item#_nxBCss1lEfG-9pEp4ObE7w"/>
        <indicatorDefinition href="../../../TDQ_Libraries/Indicators/System Indicators/Simple Statistics/Null_Count_0.1.definition#_GrAeADh9Ed2XmO7pl5Yuyg"/>
        <builtInIndicatorDefinition xmi:id="_h4DMoNF1EfGlKpMundrNlA" name="Null Count" label="Null Count">
          <taggedValue xmi:id="_h4DModF1EfGlKpMundrNlA" tag="Purpose" value="evaluate the number of missing data (null records)"/>
          <taggedValue xmi:id="_h4DMotF1EfGlKpMundrNlA" tag="Description" value="counts the number of null rows"/>
          <sqlGenericExpression xmi:id="_h4DMo9F1EfGlKpMundrNlA" body="SELECT COUNT(*) FROM &lt;%=__TABLE_NAME__%> WHERE &lt;%=__COLUMN_NAMES__%> IS NULL &lt;%=__AND_WHERE_CLAUSE__%>" language="SQL"/>
