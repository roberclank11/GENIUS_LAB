        <builtInIndicatorDefinition xmi:id="_h3Aq0NF1EfGlKpMundrNlA" name="Row Count" label="Row Count">
          <taggedValue xmi:id="_h3Aq0dF1EfGlKpMundrNlA" tag="Description" value="counts the number of rows"/>
          <taggedValue xmi:id="_h3Aq0tF1EfGlKpMundrNlA" tag="Purpose" value="evaluates the number of records"/>
