          <taggedValue xmi:id="_h5NqQtF1EfGlKpMundrNlA" tag="Description" value="counts the number of null rows"/>
          <sqlGenericExpression xmi:id="_h5NqQ9F1EfGlKpMundrNlA" body="SELECT COUNT(*) FROM &lt;%=__TABLE_NAME__%> WHERE &lt;%=__COLUMN_NAMES__%> IS NULL &lt;%=__AND_WHERE_CLAUSE__%>" language="SQL"/>
