      <indicators xsi:type="dataquality.indicators:DistinctCountIndicator" xmi:id="_G5tZJdGEEfGlKpMundrNlA" count="3095" computed="true" distinctValueCount="611">
        <parameters xmi:id="_G5tZJtGEEfGlKpMundrNlA"/>
        <analyzedElement xsi:type="TalendMetadata:MetadataColumn" href="../../../metadata/fileDelimited/OLIST/Sellers_0.1.item#_8B7IRdFkEfGmq708hwrXFw"/>
