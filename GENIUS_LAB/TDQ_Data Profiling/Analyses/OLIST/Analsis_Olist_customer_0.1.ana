        <builtInIndicatorDefinition xmi:id="_lkop8NGzEfGlKpMundrNlA" name="Row Count" label="Row Count">
          <taggedValue xmi:id="_lkop8dGzEfGlKpMundrNlA" tag="Description" value="counts the number of rows"/>
          <taggedValue xmi:id="_lkop8tGzEfGlKpMundrNlA" tag="Purpose" value="evaluates the number of records"/>
          <sqlGenericExpression xmi:id="_lkop89GzEfGlKpMundrNlA" body="SELECT COUNT(*) FROM &lt;%=__TABLE_NAME__%> &lt;%=__WHERE_CLAUSE__%>" language="SQL"/>
        </builtInIndicatorDefinition>
