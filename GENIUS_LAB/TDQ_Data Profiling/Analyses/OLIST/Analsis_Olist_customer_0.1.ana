        <builtInIndicatorDefinition xmi:id="_lkv-sNGzEfGlKpMundrNlA" name="Null Count" label="Null Count">
          <taggedValue xmi:id="_lkv-sdGzEfGlKpMundrNlA" tag="Purpose" value="evaluate the number of missing data (null records)"/>
          <taggedValue xmi:id="_lkv-stGzEfGlKpMundrNlA" tag="Description" value="counts the number of null rows"/>
          <sqlGenericExpression xmi:id="_lkv-s9GzEfGlKpMundrNlA" body="SELECT COUNT(*) FROM &lt;%=__TABLE_NAME__%> WHERE &lt;%=__COLUMN_NAMES__%> IS NULL &lt;%=__AND_WHERE_CLAUSE__%>" language="SQL"/>
