      <indicators xsi:type="dataquality.indicators:NullCountIndicator" xmi:id="_lLRHw9GzEfGlKpMundrNlA" count="99441" computed="true">
        <parameters xmi:id="_lLRHxNGzEfGlKpMundrNlA"/>
