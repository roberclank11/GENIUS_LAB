          <taggedValue xmi:id="_lldwYtGzEfGlKpMundrNlA" tag="Purpose" value="evaluates the number of records"/>
          <sqlGenericExpression xmi:id="_lldwY9GzEfGlKpMundrNlA" body="SELECT COUNT(*) FROM &lt;%=__TABLE_NAME__%> &lt;%=__WHERE_CLAUSE__%>" language="SQL"/>
        </builtInIndicatorDefinition>
