      <indicators xsi:type="dataquality.indicators:BlankCountIndicator" xmi:id="_g4OEbtGWEfGlKpMundrNlA" count="99224" computed="true">
        <parameters xmi:id="_g4OEb9GWEfGlKpMundrNlA"/>
