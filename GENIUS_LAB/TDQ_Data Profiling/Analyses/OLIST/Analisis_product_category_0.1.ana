        <builtInIndicatorDefinition xmi:id="_EiGMANGFEfGlKpMundrNlA" name="Row Count" label="Row Count">
          <taggedValue xmi:id="_EiGMAdGFEfGlKpMundrNlA" tag="Description" value="counts the number of rows"/>
          <taggedValue xmi:id="_EiGMAtGFEfGlKpMundrNlA" tag="Purpose" value="evaluates the number of records"/>
          <sqlGenericExpression xmi:id="_EiGMA9GFEfGlKpMundrNlA" body="SELECT COUNT(*) FROM &lt;%=__TABLE_NAME__%> &lt;%=__WHERE_CLAUSE__%>" language="SQL"/>
