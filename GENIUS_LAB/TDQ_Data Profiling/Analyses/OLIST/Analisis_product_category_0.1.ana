      <indicators xsi:type="dataquality.indicators:NullCountIndicator" xmi:id="_EbIoYtGFEfGlKpMundrNlA" count="71" computed="true">
        <parameters xmi:id="_EbIoY9GFEfGlKpMundrNlA"/>
        <analyzedElement xsi:type="TalendMetadata:MetadataColumn" href="../../../metadata/fileDelimited/OLIST/product_category_0.1.item#_cHdxgsv4EfGP65Woon5GhQ"/>
        <indicatorDefinition href="../../../TDQ_Libraries/Indicators/System Indicators/Simple Statistics/Null_Count_0.1.definition#_GrAeADh9Ed2XmO7pl5Yuyg"/>
        <builtInIndicatorDefinition xmi:id="_EmGiQNGFEfGlKpMundrNlA" name="Null Count" label="Null Count">
          <taggedValue xmi:id="_EmGiQdGFEfGlKpMundrNlA" tag="Purpose" value="evaluate the number of missing data (null records)"/>
          <taggedValue xmi:id="_EmGiQtGFEfGlKpMundrNlA" tag="Description" value="counts the number of null rows"/>
          <sqlGenericExpression xmi:id="_EmGiQ9GFEfGlKpMundrNlA" body="SELECT COUNT(*) FROM &lt;%=__TABLE_NAME__%> WHERE &lt;%=__COLUMN_NAMES__%> IS NULL &lt;%=__AND_WHERE_CLAUSE__%>" language="SQL"/>
        </builtInIndicatorDefinition>
