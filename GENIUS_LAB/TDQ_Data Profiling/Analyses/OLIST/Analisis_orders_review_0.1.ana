          <taggedValue xmi:id="_lj7zEtF2EfGlKpMundrNlA" tag="Purpose" value="evaluates the number of records"/>
          <sqlGenericExpression xmi:id="_lj7zE9F2EfGlKpMundrNlA" body="SELECT COUNT(*) FROM &lt;%=__TABLE_NAME__%> &lt;%=__WHERE_CLAUSE__%>" language="SQL"/>
