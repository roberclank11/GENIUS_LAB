          <taggedValue xmi:id="_llRP0dF2EfGlKpMundrNlA" tag="Purpose" value="evaluate the number of missing data (null records)"/>
          <taggedValue xmi:id="_llRP0tF2EfGlKpMundrNlA" tag="Description" value="counts the number of null rows"/>
          <sqlGenericExpression xmi:id="_llRP09F2EfGlKpMundrNlA" body="SELECT COUNT(*) FROM &lt;%=__TABLE_NAME__%> WHERE &lt;%=__COLUMN_NAMES__%> IS NULL &lt;%=__AND_WHERE_CLAUSE__%>" language="SQL"/>
