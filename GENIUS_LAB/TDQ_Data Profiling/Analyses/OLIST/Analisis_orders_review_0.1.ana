          <taggedValue xmi:id="_llOzktF2EfGlKpMundrNlA" tag="Purpose" value="evaluates the number of records"/>
          <sqlGenericExpression xmi:id="_llOzk9F2EfGlKpMundrNlA" body="SELECT COUNT(*) FROM &lt;%=__TABLE_NAME__%> &lt;%=__WHERE_CLAUSE__%>" language="SQL"/>
        </builtInIndicatorDefinition>
