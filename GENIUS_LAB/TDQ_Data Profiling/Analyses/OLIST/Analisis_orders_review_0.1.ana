      <indicators xsi:type="dataquality.indicators:NullCountIndicator" xmi:id="_laC3eNF2EfGlKpMundrNlA" count="13" computed="true">
        <parameters xmi:id="_laC3edF2EfGlKpMundrNlA"/>
        <analyzedElement xsi:type="TalendMetadata:MetadataColumn" href="../../../metadata/fileDelimited/OLIST/Order_reviews_0.1.item#_u0VFltFkEfGmq708hwrXFw"/>
